# Copy to mcp/scholar_mcp/.env (gitignored). Every key is optional except PDF2MD_API_KEY:
# a missing scholar key just means that source is skipped, the search still succeeds.
SCOPUS_API_KEY=
IEEE_API_KEY=
WOS_API_KEY=
PUBMED_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=        # optional; keyless S2 is rate-limited most days (search, snowball, recommendations)
SCHOLAR_CONTACT_EMAIL=
PAPER_PDF_UNPAYWALL_EMAIL=
PDF2MD_SERVER=https://pdf2md.fixcollege.xyz
PDF2MD_API_KEY=
