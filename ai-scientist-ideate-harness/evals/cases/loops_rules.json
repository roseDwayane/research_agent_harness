{
  "area": "bounded loops and slide-stated rules",
  "cases": [
    {"case_id": "EV-LOOP-001", "unit_id": "A5", "description": "The first snowball round is always allowed.", "tags": ["normal", "loop"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_check_loop", "args": {"loop_id": "LOOP-04", "completed": 0}}],
     "assertions": [{"path": "/data/allowed", "op": "eq", "value": true}, {"path": "/data/remaining", "op": "eq", "value": 2}]},
    {"case_id": "EV-LOOP-002", "unit_id": "A5", "description": "Boundary at 10% growth: 9.9% refuses a second round, 10% allows it.", "tags": ["boundary", "loop"], "evaluation_method": "deterministic",
     "steps": [{"id": "low", "tool": "ideate_check_loop", "args": {"loop_id": "LOOP-04", "completed": 1, "observed": {"growth": 0.099}}}, {"id": "edge", "tool": "ideate_check_loop", "args": {"loop_id": "LOOP-04", "completed": 1, "observed": {"growth": 0.1}}}],
     "assertions": [{"step": "low", "path": "/data/allowed", "op": "eq", "value": false}, {"step": "edge", "path": "/data/allowed", "op": "eq", "value": true}]},
    {"case_id": "EV-LOOP-003", "unit_id": "A5", "description": "The iteration bound wins over a good measurement: no third snowball round.", "tags": ["boundary", "loop"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_check_loop", "args": {"loop_id": "LOOP-04", "completed": 2, "observed": {"growth": 0.5}}}],
     "assertions": [{"path": "/data/allowed", "op": "eq", "value": false}, {"path": "/data/reason", "op": "contains", "value": "bound of 2"}]},
    {"case_id": "EV-LOOP-004", "unit_id": "A2.c", "description": "Fail closed: a re-plan round without the measurement its saturation rule needs is refused.", "tags": ["failure", "loop", "architecture-risk"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_check_loop", "args": {"loop_id": "LOOP-01", "completed": 1}}],
     "assertions": [{"path": "/data/allowed", "op": "eq", "value": false}, {"path": "/data/reason", "op": "contains", "value": "needs observed.new_share"}]},
    {"case_id": "EV-LOOP-005", "unit_id": "B3.5", "description": "Attack-target refetch is capped at 5 papers per topic.", "tags": ["boundary", "loop"], "evaluation_method": "deterministic",
     "steps": [{"id": "six", "tool": "ideate_check_loop", "args": {"loop_id": "LOOP-07", "completed": 0, "observed": {"items": 6}}}, {"id": "five", "tool": "ideate_check_loop", "args": {"loop_id": "LOOP-07", "completed": 0, "observed": {"items": 5}}}],
     "assertions": [{"step": "six", "path": "/data/allowed", "op": "eq", "value": false}, {"step": "five", "path": "/data/allowed", "op": "eq", "value": true}]},
    {"case_id": "EV-LOOP-006", "unit_id": "A3", "description": "A loop without a numeric bound (LOOP-03) is allowed but says so - the gap is visible (OQ-07).", "tags": ["architecture-risk", "loop"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_check_loop", "args": {"loop_id": "LOOP-03", "completed": 25}}],
     "assertions": [{"path": "/data/allowed", "op": "eq", "value": true}, {"path": "/data/reason", "op": "contains", "value": "no numeric bound"}, {"path": "/data/bound", "op": "eq", "value": null}]},
    {"case_id": "EV-LOOP-007", "unit_id": "B5", "description": "The round-2 revision may happen once; a second forced revision is refused.", "tags": ["boundary", "loop"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_check_loop", "args": {"loop_id": "LOOP-09", "completed": 1}}],
     "assertions": [{"path": "/data/allowed", "op": "eq", "value": false}]},
    {"case_id": "EV-LOOP-008", "unit_id": "A2.c", "description": "Recording a loop decision needs both run_dir and run_id.", "tags": ["invalid-input", "loop"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_check_loop", "args": {"loop_id": "LOOP-01", "completed": 0, "run_dir": "$RUN"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-LOOP-009", "unit_id": "A5", "description": "A refused iteration is recorded as LOOP_BOUND_REACHED in the run.", "tags": ["normal", "loop", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}}, {"id": "loop", "tool": "ideate_check_loop", "args": {"loop_id": "LOOP-04", "completed": 2, "run_dir": "$RUN", "run_id": "${start:/data/run_id}", "unit_id": "A5"}}, {"id": "trace", "tool": "ideate_trace", "args": {"run_dir": "$RUN", "unit_id": "A5", "run_id": "${start:/data/run_id}"}}],
     "assertions": [{"step": "loop", "path": "/data/allowed", "op": "eq", "value": false}, {"step": "trace", "path": "/data/v2_events", "op": "any_eq", "value": {"event_type": "LOOP_BOUND_REACHED"}}]},
    {"case_id": "EV-RULE-001", "unit_id": "A5", "description": "Backward threshold max(3, ceil(2% x n)): 100 -> 3, 300 -> 6, 151 -> 4.", "tags": ["rules", "boundary"], "evaluation_method": "deterministic",
     "steps": [{"id": "a", "function": "rules.snowball_threshold", "args": {"n": 100}}, {"id": "b", "function": "rules.snowball_threshold", "args": {"n": 300}}, {"id": "c", "function": "rules.snowball_threshold", "args": {"n": 151}}],
     "assertions": [{"step": "a", "path": "/data/value", "op": "eq", "value": 3}, {"step": "b", "path": "/data/value", "op": "eq", "value": 6}, {"step": "c", "path": "/data/value", "op": "eq", "value": 4}]},
    {"case_id": "EV-RULE-002", "unit_id": "F.9", "description": "Ready target max(generations, 3) + 2: default 5, 7 generations -> 9, 1 generation -> 5.", "tags": ["rules", "boundary"], "evaluation_method": "deterministic",
     "steps": [{"id": "d", "function": "rules.ready_question_target", "args": {}}, {"id": "seven", "function": "rules.ready_question_target", "args": {"max_num_generations": 7}}, {"id": "one", "function": "rules.ready_question_target", "args": {"max_num_generations": 1}}],
     "assertions": [{"step": "d", "path": "/data/value", "op": "eq", "value": 5}, {"step": "seven", "path": "/data/value", "op": "eq", "value": 9}, {"step": "one", "path": "/data/value", "op": "eq", "value": 5}]},
    {"case_id": "EV-RULE-003", "unit_id": "B5", "description": "Round cap = num_reflections + 2.", "tags": ["rules"], "evaluation_method": "deterministic",
     "steps": [{"function": "rules.reflection_round_cap", "args": {"num_reflections": 3}}],
     "assertions": [{"path": "/data/value", "op": "eq", "value": 5}]},
    {"case_id": "EV-RULE-004", "unit_id": "P3", "description": "Leaf odds are normalised within each node and multiplied along the path (legacy it_plan.leaf_odds rule).", "tags": ["rules", "regression"], "evaluation_method": "deterministic",
     "steps": [{"function": "rules.leaf_odds", "args": {"tree": {"root": "N1", "nodes": {"N1": {"branches": [{"kind": "pass", "prior": "likely", "to": "N2"}, {"kind": "fail", "prior": "unlikely", "to": "L0"}]}, "N2": {"branches": [{"kind": "supported", "prior": "possible", "to": "L1"}, {"kind": "refuted", "prior": "possible", "to": "L2"}]}}, "leaves": {"L0": {"paper": "not-publishable"}, "L1": {"paper": "finding"}, "L2": {"paper": "informative-null"}}}}}],
     "assertions": [{"path": "/data/odds/L0", "op": "eq", "value": 0.0714}, {"path": "/data/odds/L1", "op": "eq", "value": 0.4643}, {"path": "/data/odds/L2", "op": "eq", "value": 0.4643}]},
    {"case_id": "EV-RULE-005", "unit_id": "P3", "description": "A tree with a cycle or an unknown branch target is invalid input, not a crash.", "tags": ["rules", "invalid-input"], "evaluation_method": "deterministic",
     "steps": [{"function": "rules.leaf_odds", "args": {"tree": {"root": "N1", "nodes": {"N1": {"branches": [{"kind": "pass", "prior": "likely", "to": "N1"}]}}, "leaves": {}}}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-RULE-006", "unit_id": "INFRA-v2-orchestrator", "description": "Full-jitter backoff is deterministic for a seed and never exceeds the cap.", "tags": ["rules", "retry"], "evaluation_method": "deterministic",
     "steps": [{"id": "a", "function": "retry.backoff_delay", "args": {"backoff": {"base_s": 30, "factor": 2, "cap_s": 300, "jitter": "full"}, "attempt_done": 9, "seed": "E-x:9"}}, {"id": "b", "function": "retry.backoff_delay", "args": {"backoff": {"base_s": 30, "factor": 2, "cap_s": 300, "jitter": "full"}, "attempt_done": 9, "seed": "E-x:9"}}],
     "assertions": [{"step": "a", "path": "/data/delay_s", "op": "lte", "value": 300}, {"step": "b", "path": "/data/delay_s", "op": "eq", "value": "${a:/data/delay_s}"}]}
  ]
}
