{
  "area": "registry and contracts",
  "cases": [
    {"case_id": "EV-REG-001", "unit_id": "INFRA-v2-orchestrator", "description": "All 38 Units are listed with a verdict.", "tags": ["normal", "registry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_list_units", "args": {}}],
     "assertions": [{"path": "/ok", "op": "eq", "value": true}, {"path": "/data/count", "op": "eq", "value": 38}]},
    {"case_id": "EV-REG-002", "unit_id": "INFRA-v2-orchestrator", "description": "Filtering by block returns the planning block's eight Units, including the new P0, B5 and B6.", "tags": ["normal", "registry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_list_units", "args": {"block": "BLK-planning"}}],
     "assertions": [{"path": "/data/count", "op": "eq", "value": 8}, {"path": "/data/units", "op": "any_eq", "value": {"id": "P0"}}, {"path": "/data/units", "op": "any_eq", "value": {"id": "B6", "verdict": "SPLIT"}}]},
    {"case_id": "EV-REG-003", "unit_id": "A2.s", "description": "A Unit contract carries the 27-field canonical specification and its classification.", "tags": ["normal", "registry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_get_contract", "args": {"entity_id": "A2.s"}}],
     "assertions": [{"path": "/data/kind", "op": "eq", "value": "unit"}, {"path": "/data/canonical_spec", "op": "len_eq", "value": 27}, {"path": "/data/canonical_spec/parent_step", "op": "matches", "value": "^STEP-S2"}, {"path": "/data/classification", "op": "contains", "value": "maturity L4"}]},
    {"case_id": "EV-REG-004", "unit_id": "INFRA-v2-orchestrator", "description": "An unknown id is a structured UNKNOWN_ID error, not an exception.", "tags": ["invalid-input", "registry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_get_contract", "args": {"entity_id": "A9.z"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.UNKNOWN_ID"}},
    {"case_id": "EV-REG-005", "unit_id": "F.9", "description": "The fusion exit gate requires the whole reconstruct step, including the knowledge branch (A7.R3, B2).", "tags": ["normal", "registry", "architecture-risk"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_get_contract", "args": {"entity_id": "GATE-recon-check"}}],
     "assertions": [{"path": "/data/entity/requires_done", "op": "contains", "value": "F.9"}, {"path": "/data/entity/requires_done", "op": "contains", "value": "A7.R3"}, {"path": "/data/entity/requires_done", "op": "contains", "value": "B2"}]},
    {"case_id": "EV-REG-006", "unit_id": "INFRA-v2-orchestrator", "description": "Regression: the Unit inventory (ids, steps, kinds, verdicts) matches the reviewed snapshot.", "tags": ["regression", "registry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_list_units", "args": {}}],
     "expected_output": {"file": "expected/EV-REG-006.json", "path": "/data/units"}},
    {"case_id": "EV-REG-007", "unit_id": "INFRA-v2-orchestrator", "description": "Arguments violating the input schema are rejected with INPUT.INVALID before any handler runs.", "tags": ["invalid-input", "registry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_list_units", "args": {"block": "BLK-unknown"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-CON-001", "unit_id": "INFRA-units-check", "description": "The shipped contracts validate with no ERROR and no WARN.", "tags": ["normal", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": []}}],
     "assertions": [{"path": "/data/counts/ERROR", "op": "eq", "value": 0}, {"path": "/data/counts/WARN", "op": "eq", "value": 0}]},
    {"case_id": "EV-CON-002", "unit_id": "A2.s", "description": "A dependency cycle (A2.s requires A2.c) is detected.", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_unit": {"id": "A2.s", "set": {"requires": ["A1.p", "A1.q", "A1.e", "A2.c"]}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-CYCLE"}]},
    {"case_id": "EV-CON-003", "unit_id": "A2.m", "description": "A dependency on a Unit that does not exist is a dangling reference.", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_unit": {"id": "A2.m", "set": {"requires": ["A9.z"]}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-REF"}]},
    {"case_id": "EV-CON-004", "unit_id": "A3", "description": "A duplicated Unit id is reported.", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"duplicate_unit": "A3"}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-DUP-ID"}]},
    {"case_id": "EV-CON-005", "unit_id": "B3", "description": "An artifact nobody produces breaks its readers (C-IO-PRODUCER) and its declared owner (C-IO-OWNER).", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_artifact": {"id": "ART-gaps", "set": {"owners": []}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-IO-PRODUCER"}, {"path": "/data/codes", "op": "contains", "value": "C-IO-OWNER"}]},
    {"case_id": "EV-CON-006", "unit_id": "B1", "description": "Architecture risk: without D-12, B1 reads A1.v's context with no ordering guarantee (implicit dependency WARN).", "tags": ["architecture-risk", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_unit": {"id": "B1", "set": {"requires": ["A7.A1"]}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-IO-ORDER"}, {"path": "/data/counts/WARN", "op": "gte", "value": 1}]},
    {"case_id": "EV-CON-007", "unit_id": "A3.g", "description": "An empty required field fails the schema.", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_unit": {"id": "A3.g", "set": {"necessity": ""}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-SCHEMA"}]},
    {"case_id": "EV-CON-008", "unit_id": "A2.s", "description": "A Unit requiring a Unit of a later step is a forward reference.", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_unit": {"id": "A2.s", "set": {"requires": ["A1.p", "A1.q", "A1.e", "A4.b"]}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-FORWARD-REF"}]},
    {"case_id": "EV-CON-009", "unit_id": "A5", "description": "A Unit that stops listing an artifact it owns is an ownership inconsistency.", "tags": ["invalid-input", "contracts"], "evaluation_method": "deterministic",
     "steps": [{"function": "contracts.mutation", "args": {"mutations": [{"patch_unit": {"id": "A5", "set": {"outputs": {"artifacts": ["ART-snowball"], "side_effects": []}}}}]}}],
     "assertions": [{"path": "/data/codes", "op": "contains", "value": "C-IO-OWNER"}]}
  ]
