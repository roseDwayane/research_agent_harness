{
  "area": "run status and handover gates",
  "cases": [
    {"case_id": "EV-STATUS-001", "unit_id": "INFRA-ledger", "description": "A complete search block: every search Unit done (hashes verified) and the next Unit is A6.d.", "tags": ["normal", "status"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$RUN"}}],
     "assertions": [{"path": "/data/units/A4.b/state", "op": "eq", "value": "done"}, {"path": "/data/units/A1.v/state", "op": "eq", "value": "done"}, {"path": "/data/next/0/unit", "op": "eq", "value": "A6.d"}, {"path": "/data/ledger/problems", "op": "len_eq", "value": 0}]},
    {"case_id": "EV-STATUS-002", "unit_id": "A3.g", "description": "An output edited after done makes its owner stale; staleness propagates downstream but not upstream (A3.b stays done).", "tags": ["failure", "status", "architecture-risk"], "evaluation_method": "deterministic", "dataset": "search_stale",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$RUN"}}],
     "assertions": [{"path": "/data/units/A3.g/state", "op": "eq", "value": "stale"}, {"path": "/data/units/A3.g/why", "op": "contains", "value": "step3_gate.json"}, {"path": "/data/units/A3/state", "op": "eq", "value": "stale"}, {"path": "/data/units/A4.b/state", "op": "eq", "value": "stale"}, {"path": "/data/units/A3.b/state", "op": "eq", "value": "done"}, {"path": "/data/next/0/unit", "op": "eq", "value": "A3.g"}]},
    {"case_id": "EV-STATUS-003", "unit_id": "A2.s", "description": "Recovery after interruption: a begin without done is 'running' and is named first to resume.", "tags": ["recovery", "status"], "evaluation_method": "deterministic", "dataset": "search_interrupted",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$RUN"}}],
     "assertions": [{"path": "/data/units/A2.s/state", "op": "eq", "value": "running"}, {"path": "/data/next/0/unit", "op": "eq", "value": "A2.s"}, {"path": "/data/next/0/action", "op": "eq", "value": "resume (interrupted?)"}, {"path": "/data/next", "op": "len_eq", "value": 1}]},
    {"case_id": "EV-STATUS-004", "unit_id": "A3", "description": "A failed Unit blocks its dependents: A5 is not runnable while A3 is failed.", "tags": ["failure", "status"], "evaluation_method": "deterministic", "dataset": "search_failed_a3",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$RUN"}}],
     "assertions": [{"path": "/data/units/A3/state", "op": "eq", "value": "failed"}, {"path": "/data/units/A3/why", "op": "contains", "value": "C03"}, {"path": "/data/next", "op": "none_eq", "value": {"unit": "A5"}}, {"path": "/data/next/0/action", "op": "eq", "value": "fix and re-run"}]},
    {"case_id": "EV-STATUS-005", "unit_id": "INFRA-ledger", "description": "A torn ledger line is reported with its line number, and the readable events still count.", "tags": ["failure", "status"], "evaluation_method": "deterministic", "dataset": "ledger_malformed",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$RUN"}}],
     "assertions": [{"path": "/data/ledger/problems", "op": "len_eq", "value": 1}, {"path": "/data/ledger/problems/0/line", "op": "eq", "value": 11}, {"path": "/data/units/A2.s/state", "op": "eq", "value": "done"}]},
    {"case_id": "EV-STATUS-006", "unit_id": "INFRA-ledger", "description": "Regression: the state of every ledger Unit in the stale dataset matches the reviewed snapshot.", "tags": ["regression", "status"], "evaluation_method": "deterministic", "dataset": "search_stale",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$RUN"}}],
     "expected_output": {"file": "expected/EV-STATUS-006.json", "path": "/data/units"}},
    {"case_id": "EV-STATUS-007", "unit_id": "P3", "description": "Planning Units are reported by file presence for an existing generation, and a missing generation says so.", "tags": ["normal", "status"], "evaluation_method": "deterministic", "dataset": "planning",
     "steps": [{"id": "g1", "tool": "ideate_run_status", "args": {"run_dir": "$RUN", "generation": 1}}, {"id": "g3", "tool": "ideate_run_status", "args": {"run_dir": "$RUN", "generation": 3}}],
     "assertions": [{"step": "g1", "path": "/data/planning/units/P3/state", "op": "eq", "value": "done"}, {"step": "g1", "path": "/data/planning/units/B6/state", "op": "eq", "value": "todo"}, {"step": "g3", "path": "/data/planning/exists", "op": "eq", "value": false}]},
    {"case_id": "EV-STATUS-008", "unit_id": "INFRA-v2-orchestrator", "description": "Security: a folder outside the allowed roots is denied.", "tags": ["security", "invalid-input"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$OUTSIDE"}}],
     "expected_error": {"error_code": "IDEATE.PATH.DENIED"}},
    {"case_id": "EV-STATUS-009", "unit_id": "INFRA-v2-orchestrator", "description": "Security: a relative path that climbs out of the root is denied after resolution.", "tags": ["security", "invalid-input"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "empty/../../outside"}}],
     "expected_error": {"error_code": "IDEATE.PATH.DENIED"}},
    {"case_id": "EV-STATUS-010", "unit_id": "INFRA-v2-orchestrator", "description": "A directory inside the root that is not a research folder is refused.", "tags": ["invalid-input"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_run_status", "args": {"run_dir": "$WORK/empty"}}],
     "expected_error": {"error_code": "IDEATE.PATH.NOT_A_RUN_DIR"}},
    {"case_id": "EV-GATE-001", "unit_id": "A4.b", "description": "The search exit gate passes on a complete block and lists what must be disclosed.", "tags": ["normal", "gate"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-a4-check"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": true}, {"path": "/data/findings", "op": "any_eq", "value": {"level": "INFO", "message": "must disclose: accept-weak"}}, {"path": "/data/legacy_check/status", "op": "eq", "value": "not run by v2"}]},
    {"case_id": "EV-GATE-002", "unit_id": "A3.g", "description": "A gate refuses the next step when an upstream Unit is stale.", "tags": ["failure", "gate"], "evaluation_method": "deterministic", "dataset": "search_stale",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-a3-check"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": false}, {"path": "/data/findings", "op": "any_eq", "value": {"code": "GATE.UNIT.NOT_DONE", "entity": "A3.g"}}]},
    {"case_id": "EV-GATE-003", "unit_id": "A5", "description": "a5-check confirms A3 re-screened the snowball additions after A5.", "tags": ["normal", "gate"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-a5-check"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": true}, {"path": "/data/counts/ERROR", "op": "eq", "value": 0}]},
    {"case_id": "EV-GATE-004", "unit_id": "F.9", "description": "Architecture risk OQ-04: 3 ready questions of a target of 5 pass recon-check with a WARN (implementation semantics), not an ERROR.", "tags": ["boundary", "gate", "architecture-risk"], "evaluation_method": "deterministic", "dataset": "fusion_ready",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-recon-check"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": true}, {"path": "/data/findings", "op": "any_eq", "value": {"level": "WARN", "code": "GATE.RULE.ready_questions_target"}}]},
    {"case_id": "EV-GATE-005", "unit_id": "F.9", "description": "No ready and no screen_unresolved question fails recon-check.", "tags": ["failure", "gate"], "evaluation_method": "deterministic", "dataset": "fusion_no_ready",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-recon-check"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": false}, {"path": "/data/findings", "op": "any_eq", "value": {"level": "ERROR", "code": "GATE.RULE.ready_questions_target"}}]},
    {"case_id": "EV-GATE-006", "unit_id": "P3", "description": "T09 at contract level: a sound tree passes, a tree whose likeliest outcome is weak fails twice (weak share and likely weak branch).", "tags": ["gate", "architecture-risk"], "evaluation_method": "deterministic", "dataset": "planning",
     "steps": [{"id": "good", "tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-tree-check", "generation": 1}}, {"id": "weak", "tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-tree-check", "generation": 2}}],
     "assertions": [{"step": "good", "path": "/data/passed", "op": "eq", "value": true}, {"step": "weak", "path": "/data/passed", "op": "eq", "value": false}, {"step": "weak", "path": "/data/counts/ERROR", "op": "eq", "value": 2}]},
    {"case_id": "EV-GATE-007", "unit_id": "P5", "description": "Boundary: an abstract over 250 words fails the packaging gate.", "tags": ["boundary", "gate"], "evaluation_method": "deterministic", "dataset": "planning",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-pack-check", "generation": 2}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": false}, {"path": "/data/findings/0/message", "op": "contains", "value": "300 words"}]},
    {"case_id": "EV-GATE-008", "unit_id": "P3", "description": "A generation-scoped gate without a generation is invalid input.", "tags": ["invalid-input", "gate"], "evaluation_method": "deterministic", "dataset": "planning",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-tree-check"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-GATE-009", "unit_id": "INFRA-v2-orchestrator", "description": "An unknown gate id is UNKNOWN_ID.", "tags": ["invalid-input", "gate"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-nope"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.UNKNOWN_ID"}},
    {"case_id": "EV-GATE-010", "unit_id": "INFRA-ledger", "description": "A malformed ledger fails the gate with LEDGER.MALFORMED instead of guessing states.", "tags": ["failure", "gate"], "evaluation_method": "deterministic", "dataset": "ledger_malformed",
     "steps": [{"tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-a2-check"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": false}, {"path": "/data/findings", "op": "any_eq", "value": {"code": "IDEATE.LEDGER.MALFORMED"}}]},
    {"case_id": "EV-GATE-011", "unit_id": "INFRA-v2-orchestrator", "description": "With a run, the gate check is recorded as a GATE_CHECKED event.", "tags": ["normal", "gate", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}}, {"id": "gate", "tool": "ideate_check_gate", "args": {"run_dir": "$RUN", "gate_id": "GATE-frame-check", "run_id": "${start:/data/run_id}"}}],
     "assertions": [{"path": "/data/passed", "op": "eq", "value": true}, {"path": "/data/recorded_event_id", "op": "matches", "value": "^EV-"}, {"path": "/trace_id", "op": "eq", "value": "${start:/data/trace_id}"}]}
  ]
}
