{
  "area": "lifecycle events, errors, retries, reports and traces",
  "cases": [
    {"case_id": "EV-OBS-001", "unit_id": "A2.s", "description": "Happy path: RUN_STARTED -> UNIT_STARTED -> TOOL_CALLED -> UNIT_COMPLETED -> RUN_COMPLETED, all in one trace.", "tags": ["normal", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}},
       {"id": "u1", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A2.s", "instance": "Q1@1a2b3c", "actor": "script"}},
       {"id": "t1", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "TOOL_CALLED", "run_id": "${start:/data/run_id}", "unit_id": "A2.s", "instance": "Q1@1a2b3c", "tool": "mcp_bridge.py search --only Q1"}},
       {"id": "u2", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_COMPLETED", "run_id": "${start:/data/run_id}", "unit_id": "A2.s", "instance": "Q1@1a2b3c", "metrics": {"calls": 4, "duration_ms": 52000}}},
       {"id": "end", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_COMPLETED", "run_id": "${start:/data/run_id}"}}],
     "assertions": [{"step": "u2", "path": "/data/event/step_id", "op": "eq", "value": "STEP-S2"}, {"step": "u2", "path": "/data/trace_id", "op": "eq", "value": "${start:/data/trace_id}"}, {"step": "end", "path": "/ok", "op": "eq", "value": true}, {"step": "u2", "path": "/data/event/metrics/calls", "op": "eq", "value": 4}]},
    {"case_id": "EV-OBS-002", "unit_id": "A2.s", "description": "UNIT_COMPLETED without UNIT_STARTED violates the lifecycle.", "tags": ["invalid-input", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}}, {"tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_COMPLETED", "run_id": "${start:/data/run_id}", "unit_id": "A2.s"}}],
     "expected_error": {"error_code": "IDEATE.STATE.LIFECYCLE"}},
    {"case_id": "EV-OBS-003", "unit_id": "INFRA-v2-orchestrator", "description": "Events need a run: anything but RUN_STARTED without a run_id is invalid.", "tags": ["invalid-input", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "unit_id": "A2.s"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-OBS-004", "unit_id": "A3", "description": "Idempotency: the same idempotency_key twice writes once and returns the earlier event.", "tags": ["idempotency", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}},
       {"id": "a", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A3", "idempotency_key": "A3:start:1"}},
       {"id": "b", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A3", "idempotency_key": "A3:start:1"}}],
     "assertions": [{"step": "a", "path": "/data/deduplicated", "op": "eq", "value": false}, {"step": "b", "path": "/data/deduplicated", "op": "eq", "value": true}, {"step": "b", "path": "/data/event/event_id", "op": "eq", "value": "${a:/data/event/event_id}"}]},
    {"case_id": "EV-OBS-005", "unit_id": "A3", "description": "A second UNIT_STARTED while the attempt is open is refused (no duplicate execution).", "tags": ["idempotency", "observability", "failure"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}},
       {"id": "a", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A3"}},
       {"tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A3", "attempt": 2}}],
     "expected_error": {"error_code": "IDEATE.STATE.LIFECYCLE"}},
    {"case_id": "EV-OBS-006", "unit_id": "INFRA-v2-orchestrator", "description": "Security: secrets in context and messages are redacted before they are written.", "tags": ["security", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED", "message": "calling https://api.example.org/x?api_key=SECRET123&q=eeg", "context": {"api_key": "sk-abcdefghijklmnop1234", "service": "scopus", "headers": {"Authorization": "Bearer abcdefghijkl"}}}}],
     "assertions": [{"path": "/data/event/context/api_key", "op": "eq", "value": "[REDACTED]"}, {"path": "/data/event/context/headers/Authorization", "op": "eq", "value": "[REDACTED]"}, {"path": "/data/event/context/service", "op": "eq", "value": "scopus"}, {"path": "/data/event/message", "op": "matches", "value": "api_key=\\[REDACTED\\]&q=eeg"}]},
    {"case_id": "EV-OBS-007", "unit_id": "A7.D", "description": "Recovery: an interrupted attempt is closed by RECOVERY_STARTED and attempt 2 may start.", "tags": ["recovery", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}},
       {"id": "a1", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A7.D", "instance": "smith2020"}},
       {"id": "rec", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RECOVERY_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A7.D", "instance": "smith2020"}},
       {"id": "a2", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A7.D", "instance": "smith2020", "attempt": 2}}],
     "assertions": [{"step": "a2", "path": "/ok", "op": "eq", "value": true}, {"step": "a2", "path": "/data/event/attempt", "op": "eq", "value": 2}]},
    {"case_id": "EV-OBS-008", "unit_id": "A2.s", "description": "Metrics accept only the declared keys with non-negative numbers.", "tags": ["invalid-input", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED", "metrics": {"tokens_in": -5}}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-ERR-001", "unit_id": "A2.c", "description": "A Unit check code is namespaced <unit>:<code>; category, step and defaults follow from the registry.", "tags": ["normal", "error"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A2.c:R03", "error_message": "verdict stale after a re-plan round"}}],
     "assertions": [{"path": "/data/error/error_category", "op": "eq", "value": "check_failed"}, {"path": "/data/error/unit_id", "op": "eq", "value": "A2.c"}, {"path": "/data/error/step_id", "op": "eq", "value": "STEP-S2"}, {"path": "/data/error/retryable", "op": "eq", "value": false}, {"path": "/data/error/recovery_action", "op": "eq", "value": "stop"}]},
    {"case_id": "EV-ERR-002", "unit_id": "INFRA-v2-orchestrator", "description": "An unknown error code is refused (the taxonomy is closed).", "tags": ["invalid-input", "error"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "FOO", "error_message": "x"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-ERR-003", "unit_id": "A3", "description": "A check code of one Unit cannot be filed against another.", "tags": ["invalid-input", "error"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A2.c:R03", "error_message": "x", "unit_id": "A3"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}},
    {"case_id": "EV-RETRY-001", "unit_id": "INFRA-v2-orchestrator", "description": "The orchestrator may retry an interrupted Unit once under RP-UNIT, with a bounded delay.", "tags": ["normal", "retry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_retry_decision", "args": {"policy_id": "RP-UNIT", "attempts_done": 1, "requested_by": "orchestrator", "error": {"error_category": "interrupted", "error_id": "E-20261022T100000-0000abcd"}}}],
     "assertions": [{"path": "/data/action", "op": "eq", "value": "retry"}, {"path": "/data/attempt_next", "op": "eq", "value": 2}, {"path": "/data/delay_s", "op": "lte", "value": 30}]},
    {"case_id": "EV-RETRY-002", "unit_id": "A2.s", "description": "No nested retries: the orchestrator may not retry an error owned by the transport policy.", "tags": ["architecture-risk", "retry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_retry_decision", "args": {"policy_id": "RP-TRANSPORT", "attempts_done": 1, "requested_by": "orchestrator", "error": {"error_category": "external_service"}}}],
     "assertions": [{"path": "/data/action", "op": "eq", "value": "refuse"}, {"path": "/data/code", "op": "eq", "value": "IDEATE.RETRY.NESTED"}]},
    {"case_id": "EV-RETRY-003", "unit_id": "INFRA-v2-orchestrator", "description": "Bounded attempts: RP-UNIT exhausted after 2 attempts escalates.", "tags": ["boundary", "retry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_retry_decision", "args": {"policy_id": "RP-UNIT", "attempts_done": 2, "requested_by": "orchestrator", "error": {"error_category": "timeout"}}}],
     "assertions": [{"path": "/data/action", "op": "eq", "value": "escalate"}, {"path": "/data/code", "op": "eq", "value": "IDEATE.RETRY.EXHAUSTED"}]},
    {"case_id": "EV-RETRY-004", "unit_id": "A3", "description": "A deterministic failure (check_failed) is never retried; it stops.", "tags": ["failure", "retry"], "evaluation_method": "deterministic",
     "steps": [{"tool": "ideate_retry_decision", "args": {"policy_id": "RP-UNIT", "attempts_done": 1, "requested_by": "orchestrator", "error": {"error_category": "check_failed", "severity": "error"}}}],
     "assertions": [{"path": "/data/action", "op": "eq", "value": "stop"}]},
    {"case_id": "EV-RETRY-005", "unit_id": "A3", "description": "A recorded retry needs a failed attempt: RETRY_SCHEDULED after UNIT_FAILED succeeds.", "tags": ["recovery", "retry", "observability"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}},
       {"id": "s", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_STARTED", "run_id": "${start:/data/run_id}", "unit_id": "A3"}},
       {"id": "f", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "UNIT_FAILED", "run_id": "${start:/data/run_id}", "unit_id": "A3"}},
       {"id": "r", "tool": "ideate_retry_decision", "args": {"policy_id": "RP-UNIT", "attempts_done": 1, "requested_by": "orchestrator", "error": {"error_category": "interrupted"}, "record": true, "run_dir": "$RUN", "run_id": "${start:/data/run_id}", "unit_id": "A3"}}],
     "assertions": [{"step": "r", "path": "/data/action", "op": "eq", "value": "retry"}, {"step": "r", "path": "/data/recorded_event_id", "op": "matches", "value": "^EV-"}]},
    {"case_id": "EV-RETRY-006", "unit_id": "A3", "description": "RETRY_SCHEDULED without a failed attempt is refused by the lifecycle.", "tags": ["failure", "retry"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "start", "tool": "ideate_record_event", "args": {"run_dir": "$RUN", "event_type": "RUN_STARTED"}},
       {"tool": "ideate_retry_decision", "args": {"policy_id": "RP-UNIT", "attempts_done": 1, "requested_by": "orchestrator", "error": {"error_category": "interrupted"}, "record": true, "run_dir": "$RUN", "run_id": "${start:/data/run_id}", "unit_id": "A3"}}],
     "expected_error": {"error_code": "IDEATE.STATE.LIFECYCLE"}},
    {"case_id": "EV-REPORT-001", "unit_id": "INFRA-v2-orchestrator", "description": "Root cause vs propagated error: one root (A2.s source failure) and one effect (A2.c); search degraded, run incomplete, caveats to disclose.", "tags": ["normal", "report", "trace"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "root", "tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "IDEATE.EXTERNAL.UNAVAILABLE", "error_message": "scopus 429 on Q1 after the bench-and-retry", "unit_id": "A2.s", "severity": "degraded", "caveat": "source-failed", "origin": {"service": "scopus", "command": "mcp_bridge.py search --only Q1"}}},
       {"id": "child", "tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A2.c:R05", "error_message": "Q1 judged on a partial collection", "severity": "degraded", "parent_error_id": "${root:/data/error/error_id}", "caveat": "accept-weak", "must_disclose": true}},
       {"id": "rep", "tool": "ideate_build_report", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd"}},
       {"id": "tr", "tool": "ideate_trace", "args": {"run_dir": "$RUN", "error_id": "${child:/data/error/error_id}", "run_id": "r_20261022_100000_abcd"}}],
     "assertions": [{"step": "rep", "path": "/data/root_causes", "op": "len_eq", "value": 1}, {"step": "rep", "path": "/data/root_causes/0/origin", "op": "eq", "value": "A2.s@-"}, {"step": "rep", "path": "/data/by_step/STEP-S2", "op": "eq", "value": "degraded"}, {"step": "rep", "path": "/data/status", "op": "eq", "value": "incomplete"}, {"step": "rep", "path": "/data/must_disclose", "op": "contains", "value": "accept-weak"}, {"step": "rep", "path": "/data/written", "op": "contains", "value": "ERRORS.md"}, {"step": "tr", "path": "/data/chain", "op": "len_eq", "value": 2}, {"step": "tr", "path": "/data/root_cause/unit_id", "op": "eq", "value": "A2.s"}, {"step": "tr", "path": "/data/downstream_units", "op": "contains", "value": "A3"}]},
    {"case_id": "EV-REPORT-002", "unit_id": "A6.c", "description": "A fatal error stops the pipeline at its step (stopped_at).", "tags": ["failure", "report"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A6.c:F13", "error_message": "poppler not installed: figures refuses to run", "severity": "fatal"}},
       {"id": "rep", "tool": "ideate_build_report", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "write": false}}],
     "assertions": [{"path": "/data/status", "op": "eq", "value": "stopped"}, {"path": "/data/stopped_at", "op": "eq", "value": "STEP-F1"}, {"path": "/data/written", "op": "len_eq", "value": 0}]},
    {"case_id": "EV-REPORT-003", "unit_id": "A3", "description": "Partial recovery: only the latest attempt counts; a failed attempt 1 superseded by a clean attempt 2 does not fail the step.", "tags": ["recovery", "report"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "IDEATE.TOOL.TIMEOUT", "error_message": "batch 4 timed out", "unit_id": "A3", "severity": "error", "attempt": 1}},
       {"tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A3:C11", "error_message": "one low-confidence entry noted", "severity": "warning", "attempt": 2}},
       {"id": "rep", "tool": "ideate_build_report", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "write": false}}],
     "assertions": [{"path": "/data/by_step/STEP-S3", "op": "ne", "value": "failed"}, {"path": "/data/history/superseded_attempts", "op": "eq", "value": 1}, {"path": "/data/counts/error", "op": "eq", "value": 0}]},
    {"case_id": "EV-REPORT-004", "unit_id": "INFRA-v2-orchestrator", "description": "Idempotent error recording: the same idempotency_key yields one record.", "tags": ["idempotency", "error"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [
       {"id": "a", "tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A2.s:S02", "error_message": "ieee unanswered", "idempotency_key": "A2.s:S02:Q1"}},
       {"id": "b", "tool": "ideate_record_error", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "trace_id": "0123456789abcdef0123456789abcdef", "error_code": "A2.s:S02", "error_message": "ieee unanswered", "idempotency_key": "A2.s:S02:Q1"}},
       {"id": "rep", "tool": "ideate_build_report", "args": {"run_dir": "$RUN", "run_id": "r_20261022_100000_abcd", "write": false}}],
     "assertions": [{"step": "b", "path": "/data/deduplicated", "op": "eq", "value": true}, {"step": "rep", "path": "/data/history/error_records", "op": "eq", "value": 1}]},
    {"case_id": "EV-TRACE-001", "unit_id": "A3", "description": "Tracing a Unit returns its contract neighbourhood and its ledger history (the recorded fail).", "tags": ["normal", "trace"], "evaluation_method": "deterministic", "dataset": "search_failed_a3",
     "steps": [{"tool": "ideate_trace", "args": {"run_dir": "$RUN", "unit_id": "A3"}}],
     "assertions": [{"path": "/data/ledger_events", "op": "any_eq", "value": {"ev": "fail"}}, {"path": "/data/contract/gates_out", "op": "contains", "value": "GATE-a3-check"}, {"path": "/data/contract/loops", "op": "contains", "value": "LOOP-03"}]},
    {"case_id": "EV-TRACE-002", "unit_id": "INFRA-v2-orchestrator", "description": "Trace needs exactly one of unit_id or error_id.", "tags": ["invalid-input", "trace"], "evaluation_method": "deterministic", "dataset": "search_complete",
     "steps": [{"tool": "ideate_trace", "args": {"run_dir": "$RUN"}}],
     "expected_error": {"error_code": "IDEATE.INPUT.INVALID"}}
  ]
}
