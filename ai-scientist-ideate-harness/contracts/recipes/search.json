{
 "schema": "ideate-harness-recipes/1",
 "block": "search",
 "note": "How each Unit is executed (harness/recipes.py). status draft = not yet run on a real topic.",
 "recipes": [
  {
   "unit": "A1.p",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py frame schemas $RD --depth $DEPTH"
     },
     {
      "write": {
       "task": "Frame the literature search for the topic file $TOPIC (A1.p, protocol): write the protocol draft $RD/_state/A1/protocol.json with the keys topic, topic_file (= \"$TOPIC\"), depth (= \"$DEPTH\") and protocol, exactly as the rules describe (framework by the question's semantics, slots with operational roles, 2-4 search axes as OR-clusters, outcomes, timeframe, eligibility criteria, completion criterion).",
       "rules": [
        "references/search/A1-frame.md#a1p"
       ],
       "reads": [
        "$TOPIC"
       ],
       "writes": [
        "$RD/_state/A1/protocol.json"
       ],
       "schema": "$RD/_state/A1/protocol.schema.json"
      }
     },
     {
      "run": "ideate_tools.py frame set-protocol $RD $RD/_state/A1/protocol.json",
      "submit": true
     }
    ],
    "revise": [
     {
      "run": "ideate_tools.py frame schemas $RD --depth $DEPTH"
     },
     {
      "write": {
       "task": "The independent protocol evaluation (A1.e) asked for a revision. Read $RD/step1_protocol_evaluation.md and revise the protocol draft $RD/_state/A1/protocol.json to answer every finding (keep the keys topic, topic_file, depth, protocol).",
       "rules": [
        "references/search/A1-frame.md#a1p",
        "references/search/A1-frame.md#a1e"
       ],
       "reads": [
        "$TOPIC",
        "$RD/step1_protocol_evaluation.md",
        "$RD/step1_protocol.md"
       ],
       "writes": [
        "$RD/_state/A1/protocol.json"
       ],
       "schema": "$RD/_state/A1/protocol.schema.json"
      }
     },
     {
      "run": "ideate_tools.py frame set-protocol $RD $RD/_state/A1/protocol.json --note \"A1.e revision\"",
      "submit": true
     }
    ]
   },
   "check": [
    "ideate_tools.py frame check $RD --unit A1.p --json"
   ]
  },
  {
   "unit": "A1.q",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py frame strategy-brief $RD"
     },
     {
      "write": {
       "task": "Fill in the search strategy (A1.q): the tool has fixed the queries and their axes in the brief; write each query's flat words, then anchor_terms, sources and known_items, into $RD/_state/A1/strategy_fill.json as the rules say.",
       "rules": [
        "references/search/A1-frame.md#a1q-fill"
       ],
       "reads": [
        "$TOPIC",
        "$RD/_state/A1/strategy_brief.md"
       ],
       "writes": [
        "$RD/_state/A1/strategy_fill.json"
       ],
       "schema": "$RD/_state/A1/strategy_fill.schema.json"
      }
     },
     {
      "run": "ideate_tools.py frame fill-strategy $RD $RD/_state/A1/strategy_fill.json",
      "submit": true
     },
     {
      "run": "mcp_bridge.py probe $RD",
      "depth": [
       "standard",
       "deep"
      ]
     }
    ],
    "revise": [
     {
      "run": "ideate_tools.py frame strategy-brief $RD"
     },
     {
      "write": {
       "task": "The protocol evaluation (A1.e) asked for a revision; the brief is rebuilt from the revised protocol. Fill $RD/_state/A1/strategy_fill.json again, answering the evaluation's findings that concern the flat words, anchor terms, sources or known items.",
       "rules": [
        "references/search/A1-frame.md#a1q-fill"
       ],
       "reads": [
        "$TOPIC",
        "$RD/_state/A1/strategy_brief.md",
        "$RD/step1_protocol_evaluation.md"
       ],
       "writes": [
        "$RD/_state/A1/strategy_fill.json"
       ],
       "schema": "$RD/_state/A1/strategy_fill.schema.json"
      }
     },
     {
      "run": "ideate_tools.py frame fill-strategy $RD $RD/_state/A1/strategy_fill.json",
      "submit": true
     },
     {
      "run": "mcp_bridge.py probe $RD",
      "depth": [
       "standard",
       "deep"
      ]
     }
    ]
   },
   "check": [
    "ideate_tools.py frame check $RD --unit A1.q --json"
   ]
  },
  {
   "unit": "A1.e",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py frame eval-brief $RD",
      "capture": {
       "name": "N",
       "regex": "brief_r(\\d+)\\.md"
      }
     },
     {
      "write": {
       "task": "Evaluate this research protocol as an independent reader. Follow the brief brief_r$N.md exactly and answer with the JSON it asks for.",
       "rules": [
        "references/search/A1-frame.md#a1e"
       ],
       "reads": [
        "$RD/_state/A1e/brief_r$N.md",
        "$TOPIC",
        "$RD/step1_protocol.md"
       ],
       "writes": [
        "$RD/_state/A1e/round_$N.json"
       ],
       "isolated": true,
       "schema": "$RD/_state/A1e/schema_r$N.json"
      }
     },
     {
      "run": "ideate_tools.py frame set-evaluation $RD $RD/_state/A1e/round_$N.json",
      "submit": true
     }
    ]
   },
   "check": [
    "ideate_tools.py frame check $RD --unit A1.e --json"
   ],
   "note": "LOOP-02 (revision-required -> A1.p, A1.q revise -> A1.e) is driven by the conductor"
  },
  {
   "unit": "A1.v",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py frame schemas $RD --depth $DEPTH"
     },
     {
      "write": {
       "task": "Write the context draft $RD/_state/A1/context.json (A1.v): 2-4 target venues, the expert domain, and `packages` - the Python packages (import names) this topic's methods would need. Do not say what is installed: set-context imports each package and lists the data on this machine itself.",
       "rules": [
        "references/search/A1-frame.md#a1v"
       ],
       "reads": [
        "$TOPIC",
        "$RD/step1_protocol.md"
       ],
       "writes": [
        "$RD/_state/A1/context.json"
       ],
       "schema": "$RD/_state/A1/context.schema.json"
      }
     },
     {
      "run": "ideate_tools.py frame set-context $RD $RD/_state/A1/context.json",
      "submit": true
     }
    ]
   },
   "check": [
    "ideate_tools.py frame check $RD --unit A1.v --json"
   ]
  },
  {
   "unit": "A2.s",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "mcp_bridge.py search $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a2-check $RD --unit A2.s --json"
   ]
  },
  {
   "unit": "A2.m",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "mcp_bridge.py merge $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a2-check $RD --unit A2.m --json"
   ]
  },
  {
   "unit": "A2.c",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py search-check $RD"
     },
     {
      "write": {
       "task": "Judge every query of the search (A2.c) from the signals search-check computed (the brief): a verdict from each query's allowed list with its reason, an action for every missing known item and keep / retire for every ambiguous term; write $RD/_state/A2c/verdicts.json as the brief's answer section shows.",
       "rules": [
        "references/search/A2-search.md#a2c"
       ],
       "reads": [
        "$RD/_state/A2c/brief.md"
       ],
       "writes": [
        "$RD/_state/A2c/verdicts.json"
       ],
       "commands": [
        "ideate_tools.py search-check",
        "ideate_tools.py list-papers",
        "ideate_tools.py trace"
       ],
       "forbid": [
        "$RD/step3_bibliometrics.json"
       ],
       "schema": "$RD/_state/A2c/verdicts.schema.json",
       "lookups": []
      }
     },
     {
      "run": "ideate_tools.py relevance-set $RD $RD/_state/A2c/verdicts.json",
      "submit": true
     }
    ],
    "replan": [
     {
      "run": "ideate_tools.py frame replan-brief $RD"
     },
     {
      "write": {
       "task": "Re-plan the queries judged replan (A2.c): for each query in the brief, new flat words - one word per item, from its own terms - and, if one of its terms pulled it off topic, a smaller subset of that axis's terms, with the reason; write $RD/_state/A2c/replan.json.",
       "rules": [
        "references/search/A2-search.md#a2c"
       ],
       "reads": [
        "$RD/_state/A2c/replan_brief.md"
       ],
       "writes": [
        "$RD/_state/A2c/replan.json"
       ],
       "schema": "$RD/_state/A2c/replan.schema.json",
       "lookups": []
      }
     },
     {
      "run": "ideate_tools.py frame replan-apply $RD $RD/_state/A2c/replan.json",
      "submit": true,
      "capture": {
       "name": "IDS",
       "regex": "replan-ids: (\\S+)"
      }
     },
     {
      "run": "mcp_bridge.py search $RD --only $IDS"
     }
    ]
   },
   "check": [
    "ideate_tools.py a2-check $RD --unit A2.c --json"
   ],
   "note": "LOOP-01 (replan, at most 2 rounds) is driven by the conductor",
   "partial_phases": [
    "replan"
   ]
  },
  {
   "unit": "A3.b",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "mcp_bridge.py bibliometrics $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a3-check $RD --unit A3.b --json"
   ]
  },
  {
   "unit": "A3.g",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py screen-gate $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a3-check $RD --unit A3.g --json"
   ]
  },
  {
   "unit": "A3",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py screen-plan $RD --max-chars $BUDGET"
     },
     {
      "fanout": {
       "batches": "$RD/_state/fanout/A3/batch_*.in.json",
       "brief": "$RD/_state/fanout/A3/brief.md",
       "task": "Read {brief} and {batch}; write {out}.",
       "out": "field:out",
       "rules": [],
       "forbid": [
        "$RD/step3_bibliometrics.json",
        "$RD/screening_scores.json",
        "$RD/step3_shortlist.json"
       ]
      }
     },
     {
      "run": "ideate_tools.py screen-merge $RD"
     },
     {
      "run": "ideate_tools.py screen-plan $RD --max-chars $BUDGET"
     },
     {
      "fanout": {
       "batches": "$RD/_state/fanout/A3/batch_*.in.json",
       "brief": "$RD/_state/fanout/A3/brief.md",
       "task": "Read {brief} and {batch}; write {out}.",
       "out": "field:out",
       "rules": [],
       "forbid": [
        "$RD/step3_bibliometrics.json",
        "$RD/screening_scores.json",
        "$RD/step3_shortlist.json"
       ]
      }
     },
     {
      "run": "ideate_tools.py screen-merge $RD"
     },
     {
      "run": "ideate_tools.py screen-plan $RD --max-chars $BUDGET"
     },
     {
      "fanout": {
       "batches": "$RD/_state/fanout/A3/batch_*.in.json",
       "brief": "$RD/_state/fanout/A3/brief.md",
       "task": "Read {brief} and {batch}; write {out}.",
       "out": "field:out",
       "rules": [],
       "forbid": [
        "$RD/step3_bibliometrics.json",
        "$RD/screening_scores.json",
        "$RD/step3_shortlist.json"
       ]
      }
     },
     {
      "run": "ideate_tools.py screen-merge $RD"
     },
     {
      "run": "ideate_tools.py screen-build $RD $RD/screening_scores.json"
     }
    ]
   },
   "check": [
    "ideate_tools.py a3-check $RD --unit A3 --json"
   ],
   "note": "scorers are blind to venue and citations: the bibliometrics are denied to them"
  },
  {
   "unit": "A5",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "mcp_bridge.py snowball $RD"
     }
    ],
    "round2": [
     {
      "run": "mcp_bridge.py snowball $RD --round 2"
     }
    ]
   },
   "check": [
    "ideate_tools.py a5-check $RD --json"
   ],
   "note": "LOOP-04 (the additions screened again; round 2 after >= 10 % growth) is driven by the conductor"
  },
  {
   "unit": "A4.k",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py export $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a4-check $RD --unit A4.k --json"
   ]
  },
  {
   "unit": "A4.b",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "mcp_bridge.py bibliography $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a4-check $RD --unit A4.b --json"
   ]
  }
 ]
}
