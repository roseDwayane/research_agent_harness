{
 "schema": "ideate-harness-recipes/1",
 "block": "fusion",
 "note": "How each Unit is executed (harness/recipes.py). status draft = not yet run on a real topic.",
 "recipes": [
  {
   "unit": "A6.d",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py tier1 $RD"
     },
     {
      "run": "mcp_bridge.py download $RD"
     },
     {
      "run": "ideate_tools.py arxiv-pdfs $RD"
     }
    ],
    "topup": [
     {
      "run": "ideate_tools.py tier1 $RD --top-up"
     },
     {
      "run": "mcp_bridge.py download $RD"
     },
     {
      "run": "ideate_tools.py arxiv-pdfs $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a6-check $RD --unit A6.d --json"
   ],
   "note": "LOOP-08 (one top-up pass after paywall losses) is driven by the conductor"
  },
  {
   "unit": "A6.c",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "bash pdf2md.sh $RD"
     },
     {
      "run": "ideate_tools.py figures $RD"
     },
     {
      "run": "ideate_tools.py fulltext-status $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py a6-check $RD --unit A6.c --json"
   ]
  },
  {
   "unit": "A7.D",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py decon-plan $RD"
     },
     {
      "fanout": {
       "batches": "$RD/knowledge/_work/A7D/batch_*.json",
       "out": "items:papers.answer",
       "task": "Read the batch file {batch}. For each paper in it, read only that paper's own source (its full_text file, else the abstract in the batch) and write its record to its answer file ({out}), as the rules say. Never use another paper.",
       "rules": [
        "references/fusion/F1-deconstruct.md#a7d"
       ]
      }
     },
     {
      "run": "ideate_tools.py decon-merge $RD"
     }
    ]
   },
   "check": [
    "ideate_tools.py decon-check $RD --json"
   ]
  },
  {
   "unit": "A7.A1",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py align-terms $RD"
     },
     {
      "write": {
       "task": "Write one coherent vocabulary for the papers' terms (A7.A1) from the worklist align-terms wrote, to $RD/knowledge/_work/A7A/vocab.json in the format align-set takes.",
       "rules": [
        "references/fusion/F2-align.md#a7a1"
       ],
       "reads": [
        "$RD/knowledge/_work/A7A"
       ],
       "writes": [
        "$RD/knowledge/_work/A7A/vocab.json"
       ],
       "commands": [
        "ideate_tools.py list-papers",
        "ideate_tools.py trace"
       ]
      }
     },
     {
      "run": "ideate_tools.py align-set $RD $RD/knowledge/_work/A7A/vocab.json",
      "submit": true
     }
    ]
   },
   "check": [
    "ideate_tools.py align-check $RD --unit A7.A1 --json"
   ]
  },
  {
   "unit": "A7.A2",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py align-coords $RD --suggest"
     },
     {
      "run": "ideate_tools.py align-coords $RD --auto"
     },
     {
      "write": {
       "task": "Settle the coordinates align-coords --auto left ambiguous (A7.A2): write your decisions to $RD/knowledge/_work/A7A/coords.json in the format align-coords --apply takes.",
       "rules": [
        "references/fusion/F2-align.md#a7a2"
       ],
       "reads": [
        "$RD/knowledge/_work/A7A/coords_suggest.json"
       ],
       "writes": [
        "$RD/knowledge/_work/A7A/coords.json"
       ]
      }
     },
     {
      "run": "ideate_tools.py align-coords $RD --apply $RD/knowledge/_work/A7A/coords.json",
      "submit": true
     }
    ]
   },
   "check": [
    "ideate_tools.py align-check $RD --unit A7.A2 --json"
   ]
  },
  {
   "unit": "A7.A3",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py unit-begin $RD A7.A3"
     },
     {
      "run": "ideate_tools.py align-points $RD"
     },
     {
      "write": {
       "task": "Decide which concept candidates become Points (A7.A3) and write their card fields into $RD/knowledge_cards.json (points with origin align), from the papers only.",
       "rules": [
        "references/fusion/F2-align.md#a7a3"
       ],
       "reads": [
        "$RD/knowledge/_work/A7A/point_candidates.json"
       ],
       "writes": [
        "$RD/knowledge_cards.json"
       ],
       "commands": [
        "ideate_tools.py list-papers",
        "ideate_tools.py trace"
       ]
      }
     },
     {
      "run": "ideate_tools.py build-cards $RD $RD/knowledge_cards.json",
      "submit": true
     },
     {
      "run": "ideate_tools.py unit-done $RD A7.A3",
      "submit": true
     }
    ]
   },
   "check": [
    "ideate_tools.py align-check $RD --unit A7.A3 --json"
   ]
  },
  {
   "unit": "B1",
   "status": "draft",
   "scope": "topic",
   "phases": {
    "main": [
     {
      "run": "ideate_tools.py env-probe $RD --write"
     },
     {
      "write": {
       "task": "Write the lens (B1): who is looking and what this machine holds today, on the aligned concepts - the persona text and the verdicts (dataset on disk, method family affordable) - to $RD/knowledge/_work/B1/lens.json in the format lens-set takes.",
       "rules": [
        "references/fusion/F2-align.md#b1"
       ],
       "reads": [
        "$RD/step0_session_config.json",
        "$RD/knowledge/alignment.json"
       ],
       "writes": [
        "$RD/knowledge/_work/B1/lens.json"
       ]
      }
     },
     {
      "run": "ideate_tools.py lens-set $RD $RD/knowledge/_work/B1/lens.json",
      "submit": true
     },
     {
      "run": "ideate_tools.py build-methods $RD $RD/knowledge/methods_matrix_input.json $RD/knowledge/decon/*.json"
     }
    ]
   },
   "check": [
    "ideate_tools.py align-check $RD --unit B1 --json"
   ]
  },
  {
