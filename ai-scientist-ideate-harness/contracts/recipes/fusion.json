   "phases": {
    "main": [
     {
      "write": {
       "task": "Write the gap list (B3), every gap with its collisions, supporting papers, type and move, checked verbatim against the sources, to $RD/knowledge/_work/B3/gaps.json in the format gaps-set takes.",
